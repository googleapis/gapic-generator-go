func (c *fooRESTClient) NumericEnumRPC(ctx context.Context, req *foopb.EnumRequest, opts ...gax.CallOption) (*foopb.Foo, error) {
	baseUrl, err := url.Parse(c.endpoint)
	if err != nil {
		return nil, err
	}
	if err = gax.ValidatePathExpressions(
	int32(req.GetState()),
	); err != nil {
		return nil, err
	}
	baseUrl.Path += fmt.Sprintf("/v1/%v/foo", int32(req.GetState()))

	params := url.Values{}
	params.Add("$alt", "json;enum-encoding=int")
	if req.GetFilterState() != 0 {
		params.Add("filterState", fmt.Sprintf("%v", int32(req.GetFilterState())))
	}
	if items := req.GetStates(); len(items) > 0 {
		for _, item := range items {
		  params.Add("states", fmt.Sprintf("%v", int32(item)))
		}
	}

	baseUrl.RawQuery = params.Encode()

	// Build HTTP headers from client and context metadata.
	hds := []string{"x-goog-request-params", fmt.Sprintf("%s=%v", "state", int32(req.GetState()))}

	hds = append(c.xGoogHeaders, hds...)
	hds = append(hds, "Content-Type", "application/json")
	headers := gax.BuildHeaders(ctx, hds...)
	if gax.IsFeatureEnabled("METRICS") || gax.IsFeatureEnabled("TRACING") || gax.IsFeatureEnabled("LOGGING") {
		ctx = callctx.WithTelemetryContext(ctx, "rpc_method", "google.cloud.foo.v1.FooService/NumericEnumRPC")
		ctx = callctx.WithTelemetryContext(ctx, "url_template", "/v1/{state}/foo")
	}
	opts = append((*c.CallOptions).NumericEnumRPC[0:len((*c.CallOptions).NumericEnumRPC):len((*c.CallOptions).NumericEnumRPC)], opts...)
	unm := protojson.UnmarshalOptions{AllowPartial: true, DiscardUnknown: true}
	resp := &foopb.Foo{}
	e := gax.Invoke(ctx, func(ctx context.Context, settings gax.CallSettings) error {
		if settings.Path != "" {
			baseUrl.Path = settings.Path
		}
		httpReq, err := http.NewRequest("GET", baseUrl.String(), nil)
		if err != nil {
			return err
		}
		httpReq = httpReq.WithContext(ctx)
		httpReq.Header = headers

		buf, err := executeHTTPRequest(ctx, c.httpClient, httpReq, c.logger, nil, "NumericEnumRPC")
		if err != nil{
			return err
		}

		if err := unm.Unmarshal(buf, resp); err != nil {
			return err
		}

		return nil
	}, opts...)
	if e != nil {
		return nil, e
	}
	return resp, nil
}
